{
  "permissions": {
    "allow": [
      "Bash(npm --version)",
      "Bash(nvm install:*)",
      "Bash(nvm use:*)",
      "Bash(nvm alias:*)",
      "Bash(export NVM_DIR=\"$HOME/.nvm\")",
      "Bash([ -s \"$NVM_DIR/nvm.sh\" ])",
      "Bash(. \"$NVM_DIR/nvm.sh\")",
      "Bash(npm install)"
    ],
    "deny": []
  }
}